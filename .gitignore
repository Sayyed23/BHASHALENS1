# Environment variables and secrets\n.env\n.env.*\n!.env.example\n*.env\n*.env.*\n\n# AWS Credentials\n*.pem\n*.key\n*.crt\n*.p12\n*.pfx\ncredentials\naws-credentials.json\nterraform.tfvars\nterraform.tfvars.json\n*.tfvars\n*.auto.tfvars\n\n# Firebase\ngoogle-services.json\nGoogleService-Info.plist\nfirebase-adminsdk-*.json\nserviceAccountKey.json\n\n# API Keys and Secrets (but allow documentation)\n*secret*\n*secrets*\n!SECRETS_CHECKLIST.md\n!SECURITY_SETUP.md\n*apikey*\n*api-key*\n*api_key*\n*.credentials\n\n# Amplify outputs (generated, sensitive)\namplify_outputs.json\namplify/#*\n\n# Build outputs\nbuild/\ndist/\n*.log\n\n# IDE\n.vscode/\n.idea/\n*.swp\n*.swo\n*~\n\n# OS\n.DS_Store\nThumbs.db\n\n# Node modules\nnode_modules/\n\n# Flutter/Dart\n.dart_tool/\n.amplify_app_root\n.flutter-plugins\n.flutter-plugins-dependencies\n.pub-cache/\n.pub/\n\n# Terraform\n.terraform/\n.terraform.lock.hcl\n*.tfstate\n*.tfstate.*\ntfplan\noutputs.json\n\n# Python\n__pycache__/\n*.py[cod]\n*$py.class\n*.so\n.Python\nvenv/\nenv/\nENV/\n\n# Logs\n*.log\nlogs/\n\n# Data sets (Large files)\nml_pipeline/\n